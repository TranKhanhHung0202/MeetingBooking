<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KHÔI PHỤC MẬT KHẨU"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="30dp"
        android:layout_marginTop="50dp" />

    <EditText
        android:id="@+id/edtUsernameVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên đăng nhập"
        android:padding="15dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/layoutReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập mật khẩu mới bên dưới:"
            android:textColor="#4CAF50"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/edtNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu mới"
            android:inputType="textPassword"
            android:padding="15dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/edtConfirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Xác nhận mật khẩu mới"
            android:inputType="textPassword"
            android:padding="15dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="20dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnResetPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TIẾP TỤC XÁC MINH"
        android:backgroundTint="@color/design_default_color_primary"
        android:textColor="@color/white"
        android:padding="12dp" />

</LinearLayout>
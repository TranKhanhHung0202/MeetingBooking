<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="#D5D8DC" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiêu đề cuộc họp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2C3E50" />

    <TextView
        android:id="@+id/tvDetailRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Phòng A1"
        android:textColor="#3498DB"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvDetailDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 25/12/2025  |  08:00 - 10:00"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ECF0F1"
        android:layout_marginVertical="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Người tham gia:"
        android:textStyle="bold"
        android:textColor="#2C3E50" />

    <TextView
        android:id="@+id/tvDetailAttendees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đang tải danh sách: "
        android:textSize="14sp"
        android:textColor="#7F8C8D"
        android:lines="3"
        android:ellipsize="none"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Đóng"
        android:backgroundTint="#2C3E50"
        android:textColor="#FFFFFF" />
</LinearLayout>